project_id = "your-gcp-project-id"
region     = "us-central1"
zone       = "us-central1-a"

cluster_name   = "chat-platform-cluster"
node_count     = 1
machine_type   = "e2-medium"
min_node_count = 1
max_node_count = 4

public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"
pods_cidr           = "10.1.0.0/16"
services_cidr       = "10.2.0.0/16"

db_instance_name = "chat-postgres-db"
db_name          = "chatdb"
db_user          = "chatuser"
db_tier          = "db-f1-micro"
# db_password is not set here — pass it as an environment variable:
#   export TF_VAR_db_password="your-password"
#   terraform apply

domain_name = "chatms.store"
